
 <%- include("partials/header") %>

       <%- include("partials/sidebar") %>

       <div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
    </aside>


    <!-- MAIN CONTENT -->
    <main class="main">

        <!-- TOP BAR -->
        <header class="topbar">

            <div>
                <h1>Dashboard</h1>
                <p>Welcome back, Admin</p>
            </div>

            <div class="profile">
                <div class="avatar"><%= user.name.split(" ").map(n => n[0]).join("").toUpperCase() %></div>

                <div>
                  <strong><%= user.name %></strong>
<small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
                </div>
            </div>

        </header> 

        <!-- STATISTICS -->
         <% const steps = [
    { done: Number(totalTeachers) > 0, title: "Add your teachers", text: "Start here, because every class needs a teacher.", link: "/teachers", label: "Go to Teachers" },
    { done: Number(totalClasses) > 0, title: "Create your classes", text: "For example Beginner 1 or Advanced. Choose a teacher for each one.", link: "/classes", label: "Go to Classes" },
    { done: Number(totalCourses) > 0, title: "Add your courses", text: "The subjects you teach, like Qur'an or Fiqh.", link: "/courses", label: "Go to Courses" },
    { done: Number(totalStudents) > 0, title: "Register your students", text: "Put each student in a class. Their teacher follows from the class.", link: "/students", label: "Go to Students" }
]; %>
<% const doneCount = steps.filter(s => s.done).length; %>

<% if (doneCount < steps.length) { %>
<section class="panel setup-guide">
    <div class="panel-header">
        <h2>Getting started</h2>
        <span class="setup-count"><%= doneCount %> of <%= steps.length %> done</span>
    </div>
    <p class="setup-intro">Follow these steps in order to set up your school.</p>

    <div class="setup-steps">
        <% let nextShown = false; %>
        <% steps.forEach((s, i) => { %>
            <% const isNext = !s.done && !nextShown; if (isNext) nextShown = true; %>
            <div class="setup-step <%= s.done ? 'is-done' : '' %> <%= isNext ? 'is-next' : '' %>">
                <span class="setup-mark"><%= s.done ? "✓" : (i + 1) %></span>
                <div class="setup-body">
                    <strong><%= s.title %></strong>
                    <span><%= s.text %></span>
                </div>
                <% if (!s.done) { %>
                    <a href="<%= s.link %>" class="setup-link"><%= s.label %></a>
                <% } %>
            </div>
        <% }); %>
    </div>
</section>
<% } %>
        <section class="stats">

    <div class="card">
        <span class="icon">👨‍🎓</span>
        <div>
            <p>Total Students</p>
            <h2><%= totalStudents %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">👨‍🏫</span>
        <div>
            <p>Total Teachers</p>
            <h2><%= totalTeachers %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">📚</span>
        <div>
            <p>Total Courses</p>
            <h2><%= totalCourses %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">🏫</span>
        <div>
            <p>Total Classes</p>
            <h2><%= totalClasses %></h2>
        </div>
    </div>

</section>


        <!-- CONTENT GRID -->
        <section class="dashboard-grid">

            <!-- ATTENDANCE -->
         <div class="panel">

    <div class="panel-header">
        <h2>Today's Attendance</h2>
        <a href="/attendance">View Details</a>
    </div>


    <div class="attendance">

        <div class="attendance-number">
            <h1><%= attendancePercent %>%</h1>
            <p>Attendance Rate</p>
        </div>

        <div class="attendance-details">
            <p>Present: <strong><%= present %></strong></p>
            <p>Absent: <strong><%= absent %></strong></p>
        </div>

    </div>

</div>


            <!-- ANNOUNCEMENTS -->
<div class="panel">

    <div class="panel-header">
        <h2>Announcements</h2>
        <a href="/announcements">View All</a>
    </div>

    <% announcements.forEach((a, i) => { %>
        <div class="announcement" <% if (i === announcements.length - 1) { %>style="border-bottom: none;"<% } %>>
            <h3><%= a.title %></h3>
            <p><%= a.message %></p>
            <small>Posted <%= a.posted_ago %></small>
        </div>
    <% }); %>

</div>

        </section>


        <!-- RECENT STUDENTS --><section class="panel">

    <div class="panel-header">
        <h2>Recent Students</h2>
        <a href="/students">View All</a>
    </div>

    <div class="table-container">

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Admission No.</th>
                    <th>Class</th>
                    <th>Attendance</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                <% recentStudents.forEach(student => { %>
                    <tr>
                        <td><%= student.full_name %></td>
                        <td><%= student.admission_number %></td>
                        <td><%= student.class %></td>
                        <td><%= student.attendance %>%</td>
                        <td>
                            <span class="status active-status">
                                <%= student.status %>
                            </span>
                        </td>
                    </tr>
                <% }); %>

            </tbody>

        </table>

    </div>

</section>
<%- include("partials/footer") %>
    </main>


    <script src="/js/app.js"></script>

</body>
</html>
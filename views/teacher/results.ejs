<%- include("../partials/header") %>
<%- include("../partials/teacher-sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1>Results</h1>
            <p>Enter and manage results for your students</p>
        </div>
        <div class="profile">
            <div class="avatar">UA</div>
            <strong><%= user.name %></strong>
<small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
        </div>
    </header>

    <section class="panel">
        <div class="student-toolbar">
            <div>
                <h2>All Results</h2>
                <p class="toolbar-description">Results recorded for your classes</p>
            </div>
            <button class="add-student-btn" onclick="openResultModal()">
                + Add Result
            </button>
        </div>

        <div class="table-container">
            <table>
                <thead><tr><th>Student</th><th>Course</th><th>Exam Type</th><th>Score</th><th>Grade</th><th>Remarks</th></tr></thead>
                <tbody>
    <% results.forEach(result => { %>
        <tr>
            <td><div class="student-name"><div class="student-avatar"><%= result.student_name.split(" ").map(n => n[0]).join("").toUpperCase() %></div><div><strong><%= result.student_name %></strong></div></div></td>
            <td><%= result.course_name %></td>
            <td><%= result.exam_type %></td>
            <td><%= result.score %>%</td>
            <td><span class="grade grade-<%= result.grade.toLowerCase() %>"><%= result.grade %></span></td>
            <td><%= result.remarks %></td>
        </tr>
    <% }); %>
</tbody>
            </table>
        </div>
    </section>
</main>

<!-- ADD RESULT MODAL -->
<div class="modal-overlay" id="resultModal">
    <div class="student-modal">
        <div class="modal-header">
            <div><h2>Add New Result</h2><p>Record a student's score</p></div>
            <button class="close-modal" onclick="closeResultModal()">×</button>
        </div>
        <form method="POST" action="/teacher/results">
    <div class="form-grid">
        <div class="form-group">
            <label>Student</label>
            <select name="student_name" required>
                <option value="">Select student</option>
                <% students.forEach(name => { %>
                    <option><%= name %></option>
                <% }); %>
            </select>
        </div>
        <div class="form-group">
            <label>Course</label>
            <select name="course_name" required>
                <% courses.forEach(course => { %>
                    <option><%= course %></option>
                <% }); %>
            </select>
        </div>
        <div class="form-group">
            <label>Exam Type</label>
            <select name="exam_type" required><option>Test</option><option>Assignment</option><option>Examination</option></select>
        </div>
        <div class="form-group">
            <label>Score (%)</label>
            <input type="number" name="score" min="0" max="100" required>
        </div>
        <div class="form-group full-width">
            <label>Remarks</label>
            <textarea name="remarks" placeholder="Teacher's remarks"></textarea>
        </div>
    </div>
    <div class="form-actions">
        <button type="button" class="cancel-btn" onclick="closeResultModal()">Cancel</button>
        <button type="submit" class="save-btn">Save Result</button>
    </div>
</form>
    </div>
</div>

<%- include("../partials/footer") %>
<script src="/js/app.js"></script>
</body>
</html>
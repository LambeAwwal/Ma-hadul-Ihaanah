<%- include("../partials/header") %>
<%- include("../partials/student-sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1>My Results</h1>
            <p>Your recorded scores and grades</p>
        </div>
        <div class="profile">
            <div class="avatar"><%= user.name.split(" ").map(n => n[0]).join("").toUpperCase() %></div>
            <div>
                <strong><%= user.name %></strong>
                <small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
            </div>
        </div>
    </header>

    <section class="stats">
    <div class="card"><span class="icon">📊</span><div><p>Average Score</p><h2><%= results.length ? Math.round(results.reduce((s,r) => s + r.score, 0) / results.length) : 0 %>%</h2></div></div>
    <div class="card"><span class="icon">🏆</span><div><p>Best Result</p><h2><%= results.length ? Math.max(...results.map(r => r.score)) : 0 %>%</h2></div></div>
    <div class="card"><span class="icon">📚</span><div><p>Courses Graded</p><h2><%= [...new Set(results.map(r => r.course_name))].length %></h2></div></div>
    <div class="card"><span class="icon">✅</span><div><p>Pass Rate</p><h2><%= results.length ? Math.round(results.filter(r => r.score >= 50).length / results.length * 100) : 0 %>%</h2></div></div>
</section>

    <section class="panel">
        <div class="panel-header"><h2>All Results</h2></div>

        <div class="table-container">
            <table>
                <thead>
                    <tr><th>Course</th><th>Exam Type</th><th>Score</th><th>Grade</th><th>Term</th><th>Remarks</th></tr>
                </thead>
           <tbody>
    <% results.forEach(r => { %>
        <tr>
            <td><%= r.course_name %></td>
            <td><%= r.exam_type %></td>
            <td><%= r.score %>%</td>
            <td><span class="grade grade-<%= r.grade.toLowerCase() %>"><%= r.grade %></span></td>
            <td><%= r.term %></td>
            <td><%= r.remarks %></td>
        </tr>
    <% }); %>
</tbody>
            </table>
        </div>
    </section>
    <%- include("../partials/footer") %>
</main>

<script src="/js/app.js"></script>
</body>
</html>
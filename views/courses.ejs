<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1>Courses</h1>
            <p>Manage subjects taught across the school</p>
        </div>

        <div class="profile">
            <div class="avatar"><%= user.name.split(" ").map(n => n[0]).join("").toUpperCase() %></div>
            <div>
                <strong><%= user.name %></strong>
<small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
            </div>
        </div>
    </header>

    <!-- COURSE STATISTICS -->
   <section class="stats">

    <div class="card">
        <span class="icon">📖</span>
        <div>
            <p>Total Courses</p>
            <h2><%= totalCourses %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">✅</span>
        <div>
            <p>Active Courses</p>
            <h2><%= activeCourses %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">👨‍🏫</span>
        <div>
            <p>Teachers Involved</p>
            <h2><%= teachersInvolved %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">👨‍🎓</span>
        <div>
            <p>Total Enrollments</p>
            <h2><%= totalEnrollments %></h2>
        </div>
    </div>

</section>

    <!-- COURSE MANAGEMENT -->
    <section class="panel">

        <div class="student-toolbar">
            <div>
                <h2>All Courses</h2>
                <p class="toolbar-description">View and manage subjects taught at the school</p>
            </div>

            <button class="add-student-btn" onclick="openCourseModal()">
                + Add Course
            </button>
        </div>

        <!-- SEARCH + FILTER -->
        <div class="student-filters">

            <div class="search-box">
                <span>🔍</span>
                <input type="text" id="courseSearch"
                       placeholder="Search course..."
                       onkeyup="searchCourses()">
            </div>

            <select id="courseStatusFilter" onchange="filterCourses()">
                <option value="all">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

        </div>

        <!-- COURSE CARDS -->
     <div class="classes-grid" id="coursesGrid">

    <% courses.forEach(course => { %>

        <div class="class-card" data-status="<%= course.status %>">
            <div class="class-card-header">
                <h3><%= course.course_name %></h3>
                <span class="status active-status"><%= course.status %></span>
            </div>

            <div class="class-teacher">
                👤 <span><%= course.teacher_name %></span>
            </div>

            <div class="class-meta">
                <span>👨‍🎓 Students: <strong><%= course.student_count %></strong></span>
                <span>📚 Lessons: <strong><%= course.lessons_count %></strong></span>
            </div>

            <div class="course-progress">
                <div class="course-progress-label">
                    <span>Curriculum Progress</span>
                    <span><%= course.progress %>%</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= course.progress %>%;"></div>
                </div>
            </div>

       <div class="class-card-footer" style="gap: 8px;">
    <a class="action-btn" href="/courses/<%= course.id %>" style="text-decoration:none;">View</a>
    <button class="action-btn edit-course-btn"
            data-id="<%= course.id %>"
            data-name="<%= course.course_name %>"
            data-teacher="<%= course.teacher_name %>"
            data-lessons="<%= course.lessons_count %>"
            data-progress="<%= course.progress %>"
            data-status="<%= course.status %>">Edit</button>
    <button class="action-btn delete-course-btn" style="background:#fee2e2; color:#991b1b; border-color:#fee2e2;"
            data-id="<%= course.id %>"
            data-name="<%= course.course_name %>">Delete</button>
</div>
        </div>

    <% }); %>

</div>
    </section>
    <%- include("partials/footer") %>
</main>

<!-- ADD COURSE MODAL -->
<div class="modal-overlay" id="courseModal">

    <div class="student-modal">

        <div class="modal-header">
            <div>
                <h2>Add New Course</h2>
                <p>Create a new subject</p>
            </div>

            <button class="close-modal" onclick="closeCourseModal()">×</button>
        </div>

        <form method="POST" action="/courses">

    <div class="form-grid">

        <div class="form-group">
            <label>Course Name</label>
            <input type="text" name="course_name" placeholder="e.g. Arabic Grammar" required>
        </div>

        <div class="form-group">
            <label>Course Teacher</label>
      <select name="teacher_name" required>
    <option value="">Select teacher</option>
    <% teachers.forEach(t => { %>
        <option><%= t.full_name %></option>
    <% }); %>
</select>
        </div>

        <div class="form-group">
            <label>Number of Lessons</label>
            <input type="number" name="lessons_count" min="1" placeholder="20">
        </div>

        <div class="form-group">
            <label>Status</label>
            <select name="status" required>
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>

        <div class="form-group full-width">
            <label>Description</label>
            <textarea placeholder="Brief description of the course"></textarea>
        </div>

    </div>

    <div class="form-actions">
        <button type="button" class="cancel-btn" onclick="closeCourseModal()">Cancel</button>
        <button type="submit" class="save-btn">Save Course</button>
    </div>

</form>
    </div>
</div>

<!-- EDIT COURSE MODAL -->
<div class="modal-overlay" id="editCourseModal">
    <div class="student-modal">
        <div class="modal-header">
            <div>
                <h2>Edit Course</h2>
                <p>Update course details</p>
            </div>
            <button class="close-modal" onclick="closeEditCourseModal()">×</button>
        </div>

        <form method="POST" id="editCourseForm">
            <div class="form-grid">
                <div class="form-group">
                    <label>Course Name</label>
                    <input type="text" name="course_name" id="editCourseName" required>
                </div>
                <div class="form-group">
                    <label>Course Teacher</label>
                    <select name="teacher_name" id="editCourseTeacher" required>
    <% teachers.forEach(t => { %>
        <option><%= t.full_name %></option>
    <% }); %>
</select>
                </div>
                <div class="form-group">
                    <label>Number of Lessons</label>
                    <input type="number" name="lessons_count" id="editCourseLessons" min="0">
                </div>
                <div class="form-group">
                    <label>Progress (%)</label>
                    <input type="number" name="progress" id="editCourseProgress" min="0" max="100">
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select name="status" id="editCourseStatus" required>
                        <option>Active</option>
                        <option>Inactive</option>
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="cancel-btn" onclick="closeEditCourseModal()">Cancel</button>
                <button type="submit" class="save-btn">Save Changes</button>
            </div>
        </form>
    </div>
</div>

<form id="deleteCourseForm" method="POST" style="display:none;"></form>

<script src="/js/app.js"></script>

</body>
</html>
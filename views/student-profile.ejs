<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1><%= student.full_name %></h1>
            <p>Student Profile</p>
        </div>

        <div class="profile">
            <div class="avatar">
                <%= user.name.charAt(0).toUpperCase() %>
            </div>
            <div>
                <strong><%= user.name %></strong>
                <small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
            </div>
        </div>
    </header>

    <section class="panel">
    <div class="panel-header"><h2>Student Information</h2></div>

    <form method="POST" action="/students/<%= student.id %>/edit">
        <div class="form-grid">
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="full_name" value="<%= student.full_name %>" required>
            </div>
            <div class="form-group">
                <label>Admission Number</label>
                <input type="text" value="<%= student.admission_number %>" readonly style="background:#f1f5f9;">
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= student.email || '' %>">
            </div>
            <div class="form-group">
                <label>Gender</label>
                <select name="gender">
                    <option <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
                </select>
            </div>
            <div class="form-group">
                <label>Class</label>
               <div class="form-group">
    <label>Class</label>
    <select name="class" required>
        <% classes.forEach(c => { %>
            <option <%= student.class === c.class_name ? 'selected' : '' %>><%= c.class_name %></option>
        <% }); %>
    </select>
</div>
            </div>
            <div class="form-group">
                <label>Date of Birth</label>
                <input type="date" name="date_of_birth" value="<%= student.date_of_birth ? student.date_of_birth.toISOString().split('T')[0] : '' %>">
            </div>
            <div class="form-group">
                <label>Parent/Guardian</label>
                <input type="text" name="parent_guardian_name" value="<%= student.parent_guardian_name || '' %>">
            </div>
            <div class="form-group">
                <label>Parent Phone</label>
                <input type="text" name="parent_phone" value="<%= student.parent_phone || '' %>">
            </div>
            <div class="form-group full-width">
                <label>Address</label>
                <input type="text" name="address" value="<%= student.address || '' %>">
            </div>
            <div class="form-group">
                <label>Status</label>
                <select name="status">
                    <option <%= student.status === 'Active' ? 'selected' : '' %>>Active</option>
                    <option <%= student.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                </select>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="save-btn">Save Changes</button>
        </div>
    </form>
</section>

    <a href="/students" class="cancel-btn" style="display:inline-block; text-decoration:none; margin-top: 10px;">← Back to Students</a>

    <%- include("partials/footer") %>
</main>

<script src="/js/app.js"></script>

</body>
</html>
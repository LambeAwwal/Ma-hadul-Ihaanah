<%- include("partials/header") %>


       <%- include("partials/sidebar") %>


        <div class="logout">

           <a href="/logout">🚪 Logout</a>

        </div>

    </aside>


    <!-- MAIN CONTENT -->
    <main class="main">


        <!-- HEADER -->
        <header class="topbar">

            <div>

                <h1>Teachers</h1>

                <p>
                    Manage and monitor school teachers
                </p>

            </div>


            <div class="profile">

                <div class="avatar">
                    A
                </div>

                <div>

                   <strong><%= user.name %></strong>
<small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>

                </div>

            </div>

        </header>



        <!-- TEACHER STATISTICS -->
        <section class="stats">

    <div class="card">
        <span class="icon">👨‍🏫</span>
        <div>
            <p>Total Teachers</p>
            <h2><%= totalTeachers %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">✅</span>
        <div>
            <p>Active Teachers</p>
            <h2><%= activeTeachers %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">📚</span>
        <div>
            <p>Courses Taught</p>
            <h2><%= coursesTaught %></h2>
        </div>
    </div>

    <div class="card">
        <span class="icon">🏫</span>
        <div>
            <p>Classes</p>
            <h2><%= totalClasses %></h2>
        </div>
    </div>

</section>



        <!-- TEACHER MANAGEMENT -->
        <section class="panel">


            <!-- HEADER -->
            <div class="student-toolbar">

                <div>

                    <h2>
                        All Teachers
                    </h2>

                    <p class="toolbar-description">
                        View and manage registered teachers
                    </p>

                </div>


                <button
                    class="add-student-btn"
                    onclick="openTeacherModal()">

                    + Add Teacher

                </button>

            </div>



            <!-- SEARCH -->
            <div class="student-filters">


                <div class="search-box">

                    <span>
                        🔍
                    </span>

                    <input
                        type="text"
                        id="teacherSearch"
                        placeholder="Search teacher..."
                        onkeyup="searchTeachers()">

                </div>


                <select
                    id="teacherStatusFilter"
                    onchange="filterTeachers()">

                    <option value="all">
                        All Status
                    </option>

                    <option value="Active">
                        Active
                    </option>

                    <option value="Inactive">
                        Inactive
                    </option>

                </select>


            </div>



            <!-- TEACHER TABLE -->
            <div class="table-container">

                <table id="teachersTable">


                    <thead>

                        <tr>

                            <th>
                                Teacher
                            </th>

                            <th>
                                Teacher ID
                            </th>

                            <th>
                                Subject
                            </th>

                            <th>
                                Classes
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>



                    <tbody>

    <% teachers.forEach(teacher => { %>

        <tr>
            <td>
                <div class="student-name">
                    <div class="student-avatar">
                        <%= teacher.full_name.split(" ").map(n => n[0]).join("").toUpperCase() %>
                    </div>
                    <div>
                        <strong><%= teacher.full_name %></strong>
                        <small><%= teacher.email %></small>
                    </div>
         
                </div>
            </td>
            <td><%= teacher.teacher_id %></td>
            <td><%= teacher.subject %></td>
            <td><%= teacher.classes.split(",").length %></td>
            <td><%= teacher.phone %></td>
            <td><span class="status active-status"><%= teacher.status %></span></td>
            <td>
                <a class="action-btn" href="/teachers/<%= teacher.id %>" style="text-decoration:none; display:inline-block;">
    View
</a>
            </td>
        </tr>

    <% }); %>

</tbody>

                </table>

            </div>

        </section>
<%- include("partials/footer") %>
    </main>



    <!-- ==============================
         ADD TEACHER MODAL
    =============================== -->

    <div
        class="modal-overlay"
        id="teacherModal">


        <div class="student-modal">


            <!-- MODAL HEADER -->

            <div class="modal-header">

                <div>

                    <h2>
                        Add New Teacher
                    </h2>

                    <p>
                        Register a new teacher
                    </p>

                </div>


                <button
                    class="close-modal"
                    onclick="closeTeacherModal()">

                    ×

                </button>

            </div>



            <!-- FORM -->

            <form method="POST" action="/teachers">

    <div class="form-grid">

        <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="full_name" placeholder="Enter teacher's full name" required>
        </div>

        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="teacher@example.com">
        </div>

                   <div class="form-group">
    <label>Password</label>
    <input type="password" name="password" placeholder="Set login password" required minlength="6">
</div>

        <div class="form-group">
            <label>Phone Number</label>
            <input type="tel" name="phone" placeholder="08012345678" required>
        </div>

        <div class="form-group">
            <label>Main Subject</label>
            <select name="subject" required>
                <option value="">Select subject</option>
                <option>Qur'an</option>
                <option>Tajweed</option>
                <option>Arabic Language</option>
                <option>Arabic Grammar</option>
                <option>Hadith</option>
                <option>Fiqh</option>
                <option>Islamic Studies</option>
            </select>
        </div>

        <div class="form-group">
            <label>Assigned Class</label>
            <select name="classes" required>
    <option value="">Select class</option>
    <% classes.forEach(c => { %>
        <option><%= c.class_name %></option>
    <% }); %>
</select>
        </div>

        <div class="form-group">
            <label>Qualification</label>
            <input type="text" name="qualification" placeholder="e.g. B.A Arabic">
        </div>

        <div class="form-group">
            <label>Years of Experience</label>
            <input type="number" name="experience" min="0" placeholder="5">
        </div>

        <div class="form-group full-width">
            <label>Address</label>
            <textarea name="address" placeholder="Teacher's address"></textarea>
        </div>

    </div>

    <div class="form-actions">
        <button type="button" class="cancel-btn" onclick="closeTeacherModal()">Cancel</button>
        <button type="submit" class="save-btn">Save Teacher</button>
    </div>

</form>
</div>
</div>

    <script src="/js/app.js"></script>

</body>

</html>
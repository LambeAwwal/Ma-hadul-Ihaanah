<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1><%= teacher.full_name %></h1>
            <p>Teacher Profile</p>
        </div>

        <div class="profile">
            <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            <div>
                <strong><%= user.name %></strong>
                <small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
            </div>
        </div>
    </header>

    <section class="stats">
        <div class="card"><span class="icon">🏫</span><div><p>Classes Assigned</p><h2><%= classes.length %></h2></div></div>
        <div class="card"><span class="icon">👨‍🎓</span><div><p>Total Students</p><h2><%= totalStudents %></h2></div></div>
        <div class="card"><span class="icon">📚</span><div><p>Subject</p><h2 style="font-size:16px;"><%= teacher.subject %></h2></div></div>
        <div class="card"><span class="icon"><%= teacher.status === 'Active' ? '✅' : '⏸️' %></span><div><p>Status</p><h2><%= teacher.status %></h2></div></div>
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Teacher Information</h2></div>

        <div class="form-grid">
            <div class="form-group"><label>Full Name</label><input type="text" value="<%= teacher.full_name %>" readonly></div>
            <div class="form-group"><label>Teacher ID</label><input type="text" value="<%= teacher.teacher_id %>" readonly></div>
            <div class="form-group"><label>Email</label><input type="email" value="<%= teacher.email || '' %>" readonly></div>
            <div class="form-group"><label>Phone</label><input type="text" value="<%= teacher.phone || '' %>" readonly></div>
            <div class="form-group"><label>Subject</label><input type="text" value="<%= teacher.subject || '' %>" readonly></div>
            <div class="form-group"><label>Status</label><input type="text" value="<%= teacher.status %>" readonly></div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Assigned Classes</h2></div>

        <div class="table-container">
            <table>
                <thead><tr><th>Class</th><th>Schedule</th><th>Courses</th><th>Status</th></tr></thead>
                <tbody>
                    <% if (classes.length === 0) { %>
                        <tr><td colspan="4">No classes assigned yet.</td></tr>
                    <% } %>
                    <% classes.forEach(c => { %>
                        <tr>
                            <td><%= c.class_name %></td>
                            <td><%= c.schedule %></td>
                            <td><%= c.courses %></td>
                            <td><span class="status active-status"><%= c.status %></span></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>

    <a href="/teachers" class="cancel-btn" style="display:inline-block; text-decoration:none; margin-top: 10px;">← Back to Teachers</a>

    <%- include("partials/footer") %>
</main>

<script src="/js/app.js"></script>

</body>
</html>
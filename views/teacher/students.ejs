<%- include("../partials/header") %>
<%- include("../partials/teacher-sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1>My Students</h1>
            <p>Students in your assigned classes</p>
        </div>
        <div class="profile">
            <div class="avatar"><%= user.name.split(" ").map(n => n[0]).join("").toUpperCase() %></div>
            <strong><%= user.name %></strong>
<small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
        </div>
    </header>

   <section class="stats">
    <div class="card"><span class="icon">👨‍🎓</span><div><p>Total Students</p><h2><%= students.length %></h2></div></div>
    <div class="card"><span class="icon">📚</span><div><p>Classes</p><h2><%= [...new Set(students.map(s => s.class))].length %></h2></div></div>
    <div class="card"><span class="icon">✅</span><div><p>Active</p><h2><%= students.filter(s => s.status === 'Active').length %></h2></div></div>
    <div class="card"><span class="icon">📅</span><div><p>Avg. Attendance</p><h2><%= students.length ? Math.round(students.reduce((sum,s) => sum + s.attendance, 0) / students.length) : 0 %>%</h2></div></div>
</section>

    <section class="panel">
        <div class="student-toolbar">
            <div>
                <h2>All My Students</h2>
                <p class="toolbar-description">Students across your assigned classes</p>
            </div>
        </div>

        <div class="student-filters">
            <div class="search-box">
                <span>🔍</span>
                <input type="text" id="studentSearch" placeholder="Search student..." onkeyup="searchStudents()">
            </div>
            <select id="classFilter" onchange="filterStudents()">
                <option value="all">All Classes</option>
                <option>Intermediate 1</option>
                <option>Advanced</option>
            </select>
        </div>

        <div class="table-container">
            <table id="studentsTable">
                <thead>
                    <tr><th>Student</th><th>Admission No.</th><th>Class</th><th>Gender</th><th>Attendance</th><th>Status</th></tr>
                </thead>
                <tbody>
    <% students.forEach(student => { %>
        <tr>
            <td><div class="student-name">
                <div class="student-avatar"><%= student.full_name.split(" ").map(n => n[0]).join("").toUpperCase() %></div>
                <div><strong><%= student.full_name %></strong></div></div></td>
            <td><%= student.admission_number %></td>
            <td><%= student.class %></td>
            <td><%= student.gender %></td>
            <td><%= student.attendance %>%</td>
            <td><span class="status active-status"><%= student.status %></span></td>
        </tr>
    <% }); %>
</tbody>
            </table>
        </div>
    </section>
    <%- include("../partials/footer") %>
</main>

<script src="/js/app.js"></script>
</body>
</html>
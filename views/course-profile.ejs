<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<div class="logout">
    <a href="/logout">🚪 Logout</a>
</div>
</aside>

<main class="main">

    <header class="topbar">
        <div>
            <h1><%= course.course_name %></h1>
            <p>Course Details</p>
        </div>

        <div class="profile">
            <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            <div>
                <strong><%= user.name %></strong>
                <small><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></small>
            </div>
        </div>
    </header>

    <section class="stats">
        <div class="card"><span class="icon">👤</span><div><p>Teacher</p><h2 style="font-size:16px;"><%= course.teacher_name %></h2></div></div>
        <div class="card"><span class="icon">👨‍🎓</span><div><p>Students</p><h2><%= students.length %></h2></div></div>
        <div class="card"><span class="icon">📚</span><div><p>Lessons</p><h2><%= course.lessons_count %></h2></div></div>
        <div class="card"><span class="icon">📈</span><div><p>Progress</p><h2><%= course.progress %>%</h2></div></div>
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Course Information</h2></div>

        <div class="form-grid">
            <div class="form-group"><label>Course Name</label><input type="text" value="<%= course.course_name %>" readonly></div>
            <div class="form-group"><label>Teacher</label><input type="text" value="<%= course.teacher_name %>" readonly></div>
            <div class="form-group"><label>Status</label><input type="text" value="<%= course.status %>" readonly></div>
            <div class="form-group"><label>Lessons</label><input type="text" value="<%= course.lessons_count %>" readonly></div>
        </div>

        <div class="course-progress" style="margin-top: 20px;">
            <div class="course-progress-label"><span>Curriculum Progress</span><span><%= course.progress %>%</span></div>
            <div class="progress-bar"><div class="progress-fill" style="width: <%= course.progress %>%;"></div></div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-header"><h2>Classes Taking This Course</h2></div>

        <div class="table-container">
            <table>
                <thead><tr><th>Class</th><th>Teacher</th><th>Schedule</th></tr></thead>
                <tbody>
                    <% if (classes.length === 0) { %>
                        <tr><td colspan="3">No classes are taking this course yet.</td></tr>
                    <% } %>
                    <% classes.forEach(c => { %>
                        <tr>
                            <td><%= c.class_name %></td>
                            <td><%= c.teacher_name %></td>
                            <td><%= c.schedule %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </section>

    <a href="/courses" class="cancel-btn" style="display:inline-block; text-decoration:none; margin-top: 10px;">← Back to Courses</a>

    <%- include("partials/footer") %>
</main>

<script src="/js/app.js"></script>

</body>
</html>